{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/public/menu-images/* {
		reverse_proxy api:8080
	}
	@api path /api /api/*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy api:8080
	}
	@private path /health /health/* /openapi /openapi/*
	handle @private {
		respond 404
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@page {
		path / /staff /staff/* /platform /platform/* /q /q/*
		not path_regexp extension \.[^/]+$
	}
	handle @page {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
}
