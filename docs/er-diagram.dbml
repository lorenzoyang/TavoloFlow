Project TavoloFlow_MVP_V1 {
  database_type: 'PostgreSQL'
  Note: '''
    TavoloFlow MVP (simplified): 9 tables, one menu per restaurant.
    Removed optimistic version columns except session bill_version.
    No join-code/QR reset in V1; closing a session invalidates guest cookies.
    EF Core Migrations create the real PostgreSQL schema.
    Cross-table rules, filtered unique indexes, and transaction locks
    are configured in EF Core and application services.
    Permanent restaurant deletion cascades to all restaurant-owned data,
    including historical and soft-deleted records. Internal references
    use NO ACTION; platform users are independent.
  '''
}

// 01 - Platform and restaurant accounts
Table platform_users {
  id uuid [pk]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  credential_version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  Checks {
    `credential_version > 0` [name: 'ck_platform_user_credential_version']
  }

  Note: 'One platform administrator is securely bootstrapped; never commit credentials.'
}

Table restaurants {
  id uuid [pk]
  name varchar(150) [not null]
  default_language varchar(2) [not null, note: 'Restaurant selects zh, it, or en at creation']
  time_zone varchar(64) [not null, default: 'Europe/Rome']
  currency_code char(3) [not null, default: 'EUR']
  service_status varchar(16) [not null, default: 'SUSPENDED']
  ordering_enabled boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Checks {
    `default_language IN ('zh', 'it', 'en')` [name: 'ck_restaurant_default_language']
    `currency_code = 'EUR'` [name: 'ck_restaurant_currency']
    `service_status IN ('ACTIVE', 'SUSPENDED')` [name: 'ck_restaurant_service_status']
  }
}

Table restaurant_users {
  id uuid [pk]
  restaurant_id uuid [not null]
  username varchar(50) [not null, unique, note: 'Normalize to lowercase before saving']
  password_hash varchar(255) [not null]
  role varchar(10) [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  credential_version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (restaurant_id, role) [unique, name: 'uq_restaurant_account_role']
    (id, restaurant_id) [unique, name: 'uq_restaurant_users_id_tenant']
  }

  Checks {
    `role IN ('OWNER', 'STAFF')` [name: 'ck_restaurant_user_role']
    `credential_version > 0` [name: 'ck_restaurant_user_credential_version']
    `username = lower(btrim(username)) AND username ~ '[^[:space:]]'` [name: 'ck_restaurant_user_username']
  }

  Note: 'At most one OWNER and STAFF account per restaurant. Create both in the restaurant bootstrap transaction.'
}

// 02 - Restaurant tables and one menu hierarchy
Table restaurant_tables {
  id uuid [pk]
  restaurant_id uuid [not null]
  table_label varchar(50) [not null]
  qr_token varchar(128) [not null, unique, note: 'Random fixed QR entrance token, not a join code']
  is_enabled boolean [not null, default: true]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_tables_id_tenant']
    restaurant_id
  }

  Note: '''
    EF Core filtered unique index: (restaurant_id, table_label)
      WHERE deleted_at IS NULL.
    To replace a QR token, soft-delete the table only when it has no
    ACTIVE dining session, create a new table, and reprint its QR code.
    Ordinary table maintenance must not delete a table with an ACTIVE
    dining session. Permanent restaurant deletion removes all its data.
  '''
}

Table menu_categories {
  id uuid [pk]
  restaurant_id uuid [not null]
  name_zh varchar(100)
  name_it varchar(100)
  name_en varchar(100)
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_categories_id_tenant']
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_category_has_name']
  }

  Note: 'At least one localized name; normalize whitespace-only names to NULL. Client falls back to another available translation.'
}

Table menu_items {
  id uuid [pk]
  restaurant_id uuid [not null]
  category_id uuid [not null]
  item_code varchar(40)
  name_zh varchar(150)
  name_it varchar(150)
  name_en varchar(150)
  description_zh text
  description_it text
  description_en text
  price_cents bigint [not null]
  allergen_codes "text[]" [not null, default: '{}', note: 'Only 14 predefined EU allergen codes, validated by the API']
  allergen_reviewed boolean [not null, default: false, note: 'true + empty codes = reviewed, no identified declarable allergens']
  is_available boolean [not null, default: true]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_menu_items_id_tenant']
    (restaurant_id, category_id)
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_item_has_name']
    `price_cents > 0` [name: 'ck_item_positive_price']
  }

  Note: '''
    No menus or allergens tables in MVP.
    Require at least one localized name when saving.
    Normalize blank names/codes to NULL.
    EF Core filtered unique index: (restaurant_id, item_code)
      WHERE deleted_at IS NULL AND item_code IS NOT NULL.
    allergen_reviewed=false means no completed restaurant review.
    allergen_reviewed=true + empty allergen_codes means reviewed and
    no identified declarable allergens; do not promise zero cross-contact.
    Reconfirm review when allergen_codes are edited.
  '''
}

// 03 - Each visit, submission, and immutable order lines
Table dining_sessions {
  id uuid [pk]
  restaurant_id uuid [not null]
  table_id uuid [not null]
  status varchar(10) [not null, default: 'ACTIVE']
  join_code_ciphertext text [note: 'Encrypt reversible 4-character join code; NULL after closing']
  bill_version int [not null, default: 1, note: 'Per-session counter. Increment once per successful new order or cancellation']
  table_label_snapshot varchar(50) [not null]
  opened_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  close_reason varchar(10)
  closed_total_cents bigint

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_sessions_id_tenant']
    (table_id, status)
  }

  Checks {
    `status IN ('ACTIVE', 'CLOSED')` [name: 'ck_session_status']
    `bill_version > 0` [name: 'ck_session_bill_version']
    `close_reason IS NULL OR close_reason IN ('PAID', 'VOIDED', 'EMPTY')` [name: 'ck_session_close_reason']
    `(status = 'ACTIVE' AND closed_at IS NULL AND close_reason IS NULL AND closed_total_cents IS NULL AND join_code_ciphertext IS NOT NULL) OR (status = 'CLOSED' AND closed_at IS NOT NULL AND close_reason IS NOT NULL AND closed_total_cents IS NOT NULL AND join_code_ciphertext IS NULL)` [name: 'ck_session_lifecycle']
    `closed_total_cents IS NULL OR closed_total_cents >= 0` [name: 'ck_session_closed_total']
    `closed_at IS NULL OR closed_at >= opened_at` [name: 'ck_session_close_time']
  }

  Note: '''
    EF Core filtered unique index: (table_id) WHERE status = 'ACTIVE'.
    Opening/closing timestamps are retained without shared-account attribution.
    No join-code or QR reset in V1. A protected HttpOnly guest cookie
    binds restaurant, table, and session; it never stores the join code.
    Validate cookie and ACTIVE session on every protected guest request.
    After network failure, open-table UI must query current table state
    and require fresh staff confirmation, not auto-retry the old POST.
    bill_version begins at 1 for each new session and increments only
    when a new order is persisted or an order is actually cancelled.
    Order creation/cancellation and checkout must lock this session row
    inside their transactions. Checkout compares expected bill_version
    and confirmed amount before closing.
  '''
}

Table orders {
  id uuid [pk]
  restaurant_id uuid [not null]
  dining_session_id uuid [not null]
  client_request_id uuid [not null, note: 'Same ID on retry; not a secret']
  status varchar(12) [not null, default: 'NEW']
  total_amount_cents bigint [not null]
  order_note text
  default_language_snapshot varchar(2) [not null]
  created_at timestamptz [not null, default: `now()`]
  ready_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancel_reason text

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_orders_id_tenant']
    (dining_session_id, client_request_id) [unique, name: 'uq_order_one_per_request']
    (restaurant_id, status, created_at)
  }

  Checks {
    `status IN ('NEW', 'READY', 'CANCELLED')` [name: 'ck_order_status']
    `total_amount_cents >= 0` [name: 'ck_order_amount']
    `default_language_snapshot IN ('zh', 'it', 'en')` [name: 'ck_order_language']
    `(status = 'NEW' AND ready_at IS NULL AND cancelled_at IS NULL AND cancelled_by_user_id IS NULL AND cancel_reason IS NULL) OR (status = 'READY' AND ready_at IS NOT NULL AND cancelled_at IS NULL AND cancelled_by_user_id IS NULL AND cancel_reason IS NULL) OR (status = 'CANCELLED' AND cancelled_at IS NOT NULL AND cancelled_by_user_id IS NOT NULL AND cancel_reason IS NOT NULL AND cancel_reason ~ '[^[:space:]]')` [name: 'ck_order_lifecycle']
    `(ready_at IS NULL OR ready_at >= created_at) AND (cancelled_at IS NULL OR cancelled_at >= created_at) AND (ready_at IS NULL OR cancelled_at IS NULL OR cancelled_at >= ready_at)` [name: 'ck_order_transition_times']
  }

  Note: '''
    Each submission or add-on creates one order.
    Retry with the same client_request_id returns the original order,
    even if the resent payload differs; it never creates a second one.
    The UI preserves the original payload
    while status is unknown and shows the persisted server result.
    Enforce idempotency and amounts with PostgreSQL constraints + transactions.
    Change NEW -> READY or NEW -> CANCELLED with conditional UPDATE.
    READY -> CANCELLED is OWNER only; closed sessions cannot change.
    No order version field is needed.
    Do not allow guest access to orders after the session closes.
  '''
}

Table order_items {
  id uuid [pk]
  restaurant_id uuid [not null]
  order_id uuid [not null]
  menu_item_id uuid [not null]
  item_code_snapshot varchar(40)
  name_zh_snapshot varchar(150)
  name_it_snapshot varchar(150)
  name_en_snapshot varchar(150)
  allergen_codes_snapshot "text[]" [not null, default: '{}']
  unit_price_cents bigint [not null]
  quantity int [not null]
  remark text

  Indexes {
    (order_id, restaurant_id)
  }

  Checks {
    `concat(name_zh_snapshot, name_it_snapshot, name_en_snapshot) ~ '[^[:space:]]'` [name: 'ck_order_item_has_name']
    `unit_price_cents >= 0` [name: 'ck_order_item_unit_price']
    `quantity > 0` [name: 'ck_order_item_quantity']
  }

  Note: 'Historical name, price, and allergen snapshots. Line total = unit_price_cents * quantity; no separate line_total_cents.'
}

// Restaurant ownership: a permanent restaurant DELETE removes the entire tenant.
Ref: restaurant_users.restaurant_id > restaurants.id [delete: cascade]
Ref: restaurant_tables.restaurant_id > restaurants.id [delete: cascade]
Ref: menu_categories.restaurant_id > restaurants.id [delete: cascade]
Ref: menu_items.restaurant_id > restaurants.id [delete: cascade]
Ref: dining_sessions.restaurant_id > restaurants.id [delete: cascade]
Ref: orders.restaurant_id > restaurants.id [delete: cascade]
Ref: order_items.restaurant_id > restaurants.id [delete: cascade]

// Internal references protect history when individual records are deleted.
// Composite FKs keep related records in the same restaurant.
Ref: menu_items.(category_id, restaurant_id) > menu_categories.(id, restaurant_id) [delete: no action]
Ref: dining_sessions.(table_id, restaurant_id) > restaurant_tables.(id, restaurant_id) [delete: no action]
Ref: orders.(dining_session_id, restaurant_id) > dining_sessions.(id, restaurant_id) [delete: no action]
Ref: orders.(cancelled_by_user_id, restaurant_id) > restaurant_users.(id, restaurant_id) [delete: no action]
Ref: order_items.(order_id, restaurant_id) > orders.(id, restaurant_id) [delete: no action]
Ref: order_items.(menu_item_id, restaurant_id) > menu_items.(id, restaurant_id) [delete: no action]

TableGroup platform_and_accounts {
  platform_users
  restaurants
  restaurant_users
}

TableGroup tables_and_menu {
  restaurant_tables
  menu_categories
  menu_items
}

TableGroup dining_and_orders {
  dining_sessions
  orders
  order_items
}
