Project TavoloFlow_MVP_V1 {
  database_type: 'PostgreSQL'
  Note: '''
    TavoloFlow: 15 tables, one menu per restaurant, offline service subscriptions.
    Credential versions revoke account tickets; subscription_version guards
    service administration and bill_version guards session bill confirmation.
    No join-code/QR reset in V1; closing a session invalidates guest cookies.
    EF Core Migrations create the real PostgreSQL schema.
    Cross-table rules, filtered unique indexes, and transaction locks
    are configured in EF Core and application services.
    Permanent restaurant deletion cascades to all restaurant-owned data,
    including historical records. Session-to-order, order-to-line,
    item-to-photo, group-to-option and both dish/group-to-link references
    cascade; other internal references use NO ACTION.
    Catalog deletion operations detach nullable historical links first.
    Platform users are independent.
  '''
}

// 01 - Platform and restaurant accounts
Table platform_users {
  id uuid [pk]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  credential_version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  Checks {
    `credential_version > 0` [name: 'ck_platform_user_credential_version']
  }

  Note: 'One platform administrator is securely bootstrapped; never commit credentials.'
}

Table restaurants {
  id uuid [pk]
  name varchar(150) [not null]
  default_language varchar(2) [not null, note: 'Restaurant selects zh, it, or en at creation']
  time_zone varchar(64) [not null, default: 'Europe/Rome']
  currency_code char(3) [not null, default: 'EUR']
  service_status varchar(16) [not null, default: 'SUSPENDED']
  ordering_enabled boolean [not null, default: false]
  join_code_required boolean [not null, default: true, note: 'Platform-only switch; false lets guests join an open table without its join code']
  theme varchar(16) [not null, default: 'TERRACOTTA', note: 'Platform-chosen colour preset for guest and staff pages; colours only']
  dine_in_enabled boolean [not null, default: true, note: 'Platform switch for QR dine-in; without it the floor and tables are gone and QR pages only browse']
  online_enabled boolean [not null, default: false, note: 'Platform switch for online ordering through /r/{slug}']
  slug varchar(40) [note: 'Readable online ordering link /r/{slug}; required while online ordering is on, never cleared']
  public_phone varchar(16) [note: 'OWNER-set phone shown to online customers; online ordering stays closed without it']
  online_paused_until timestamptz [note: 'STAFF/OWNER pause of online ordering; lapses on its own once the time passes']
  delivery_enabled boolean [not null, default: false, note: 'OWNER switch for restaurant-run delivery; off only stops new delivery submissions']
  delivery_note_zh varchar(500) [note: 'Optional delivery area and fee rules shown at checkout, per language']
  delivery_note_it varchar(500)
  delivery_note_en varchar(500)
  owner_contact varchar(500)
  default_annual_fee_cents bigint
  subscription_version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  google_maps_url varchar(2048) [note: 'Platform-only HTTPS Google Maps link, reserved for a public restaurant list']

  Indexes {
    slug [unique, name: 'uq_restaurant_slug']
  }

  Checks {
    `default_language IN ('zh', 'it', 'en')` [name: 'ck_restaurant_default_language']
    `currency_code = 'EUR'` [name: 'ck_restaurant_currency']
    `service_status IN ('ACTIVE', 'SUSPENDED')` [name: 'ck_restaurant_service_status']
    `subscription_version > 0` [name: 'ck_restaurant_subscription_version']
    `default_annual_fee_cents IS NULL OR default_annual_fee_cents BETWEEN 0 AND 9007199254740991` [name: 'ck_restaurant_annual_fee']
    `google_maps_url IS NULL OR google_maps_url LIKE 'https://%'` [name: 'ck_restaurant_google_maps_url']
    `theme IN ('TERRACOTTA', 'LACQUER', 'INDIGO', 'INK', 'TARO')` [name: 'ck_restaurant_theme']
    `dine_in_enabled OR online_enabled` [name: 'ck_restaurant_services']
    `NOT online_enabled OR slug IS NOT NULL` [name: 'ck_restaurant_online_slug']
    `slug IS NULL OR slug ~ '^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$'` [name: 'ck_restaurant_slug']
    `public_phone IS NULL OR public_phone ~ '^\+?[0-9]{6,15}$'` [name: 'ck_restaurant_public_phone']
  }
}

Table online_hours {
  restaurant_id uuid [not null]
  weekday int [not null, note: 'ISO weekday in the restaurant time zone: Monday 1, Sunday 7']
  slot int [not null, note: '1 or 2, numbered by opening time within the weekday']
  opens_minute int [not null]
  closes_minute int [not null, note: 'Exclusive last moment to order; 1440 is midnight']

  Indexes {
    (restaurant_id, weekday, slot) [pk]
  }
  Checks {
    `weekday BETWEEN 1 AND 7` [name: 'ck_online_hour_weekday']
    `slot IN (1, 2)` [name: 'ck_online_hour_slot']
    `opens_minute >= 0 AND opens_minute < closes_minute AND closes_minute <= 1440` [name: 'ck_online_hour_minutes']
  }
  Note: 'Weekly online ordering hours. OWNER saves the whole week under the restaurant UPDATE lock; slots never cross midnight and the second starts no earlier than the first ends.'
}

Table online_counters {
  restaurant_id uuid [not null]
  business_date date [not null, note: 'Restaurant local date']
  last_number int [not null]

  Indexes {
    (restaurant_id, business_date) [pk]
  }
  Checks {
    `last_number > 0` [name: 'ck_online_counter_number']
  }
  Note: 'The last daily pickup/delivery number. A submission takes the next one with INSERT ... ON CONFLICT DO UPDATE ... RETURNING, which also serializes one restaurant-day of submissions.'
}

Table online_requests {
  id uuid [pk]
  restaurant_id uuid [not null]
  client_request_id uuid [not null]
  status_token varchar(128) [not null, unique, note: 'Random 32-byte Base64URL secret of the status page /o/{token}']
  business_date date [not null]
  number int [not null]
  fulfillment varchar(10) [not null, note: 'PICKUP or DELIVERY; becomes the session channel on acceptance']
  customer_name varchar(30) [note: 'Required at submission, cleared after 30 days']
  customer_phone varchar(16) [note: 'Required at submission, cleared after 30 days']
  delivery_address varchar(200) [note: 'Delivery only']
  delivery_notes varchar(100) [note: 'Delivery only']
  lines jsonb [not null, note: 'OrderLineSnapshot array: the order_items snapshot fields with nested options']
  items_total_cents bigint [not null]
  default_language_snapshot varchar(2) [not null]
  submitted_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'submitted_at + 10 minutes']
  accepted_at timestamptz
  estimated_at timestamptz
  session_id uuid
  rejected_at timestamptz
  reject_reason varchar(12) [note: 'SOLD_OUT, BUSY, CLOSING or OUT_OF_RANGE (delivery only)']

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_online_requests_id_tenant']
    (restaurant_id, client_request_id) [unique, name: 'uq_online_request_client_request']
    (restaurant_id, business_date, number) [unique, name: 'uq_online_request_number']
    (session_id, restaurant_id) [unique, name: 'uq_online_request_session']
    (restaurant_id, expires_at) [name: 'ix_online_requests_waiting', note: 'WHERE accepted_at IS NULL AND rejected_at IS NULL']
    (restaurant_id, submitted_at) [name: 'ix_online_requests_contact', note: 'WHERE customer_phone IS NOT NULL']
  }
  Checks {
    `fulfillment IN ('PICKUP', 'DELIVERY')` [name: 'ck_online_request_fulfillment']
    `number > 0` [name: 'ck_online_request_number']
    `items_total_cents > 0` [name: 'ck_online_request_total']
    `default_language_snapshot IN ('zh', 'it', 'en')` [name: 'ck_online_request_language']
    `jsonb_typeof(lines) = 'array'` [name: 'ck_online_request_lines']
    `customer_phone IS NULL OR customer_phone ~ '^\+?[0-9]{6,15}$'` [name: 'ck_online_request_phone']
    `fulfillment = 'DELIVERY' OR (delivery_address IS NULL AND delivery_notes IS NULL)` [name: 'ck_online_request_pickup_address']
    `expires_at > submitted_at` [name: 'ck_online_request_expiry']
    `(accepted_at IS NULL OR rejected_at IS NULL) AND (accepted_at IS NULL OR accepted_at < expires_at) AND (rejected_at IS NULL OR rejected_at < expires_at)` [name: 'ck_online_request_decision']
    `(accepted_at IS NULL AND estimated_at IS NULL AND session_id IS NULL) OR (accepted_at IS NOT NULL AND estimated_at IS NOT NULL AND estimated_at >= accepted_at AND session_id IS NOT NULL)` [name: 'ck_online_request_accepted']
    `reject_reason IS NULL OR (rejected_at IS NOT NULL AND (reject_reason IN ('SOLD_OUT', 'BUSY', 'CLOSING') OR (reject_reason = 'OUT_OF_RANGE' AND fulfillment = 'DELIVERY')))` [name: 'ck_online_request_reject_reason']
  }
  Note: '''
    One online submission, with no status column: accepted (accepted_at),
    rejected (rejected_at), waiting (neither, now < expires_at) or expired
    (neither, now >= expires_at), always with now from TimeProvider.
    Only acceptance creates the session, its single order and the order items,
    copied from lines; expired and rejected requests never do.
    lines.menuItemId is not a foreign key.
  '''
}

Table restaurant_users {
  id uuid [pk]
  restaurant_id uuid [not null]
  username varchar(50) [not null, unique, note: 'Normalize to lowercase before saving']
  password_hash varchar(255) [not null]
  role varchar(10) [not null]
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: true]
  credential_version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (restaurant_id, role) [unique, name: 'uq_restaurant_account_role']
    (id, restaurant_id) [unique, name: 'uq_restaurant_users_id_tenant']
  }

  Checks {
    `role IN ('OWNER', 'STAFF')` [name: 'ck_restaurant_user_role']
    `credential_version > 0` [name: 'ck_restaurant_user_credential_version']
    `username = lower(btrim(username)) AND username ~ '[^[:space:]]'` [name: 'ck_restaurant_user_username']
  }

  Note: 'At most one OWNER and STAFF account per restaurant. Create both in the restaurant bootstrap transaction.'
}

// Staff devices that receive lock-screen notifications of new online orders.
Table push_subscriptions {
  id uuid [pk]
  restaurant_id uuid [not null]
  user_id uuid [not null]
  endpoint varchar(2048) [not null, unique, note: 'Browser push service URL; only known services are accepted']
  p256dh varchar(128) [not null, note: 'Device P-256 public key, base64url']
  auth varchar(128) [not null, note: 'Device 16-byte auth secret, base64url']
  credential_version int [not null, note: 'The account version when the device registered']
  language varchar(2) [not null, note: 'Notification language: zh, it or en']
  expires_at timestamptz [not null, note: 'Expiry of the sign-in that registered the device']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    endpoint [unique, name: 'uq_push_subscription_endpoint']
    restaurant_id [name: 'ix_push_subscriptions_restaurant']
  }

  Checks {
    `credential_version > 0` [name: 'ck_push_subscription_credential_version']
    `language IN ('zh', 'it', 'en')` [name: 'ck_push_subscription_language']
  }

  Note: '''
    One row per device, upserted on endpoint, so signing in on the device moves it to that account.
    A row stops receiving, and is deleted before sending or registering, once its account is inactive,
    must change its password or has another credential version, or once expires_at has passed.
  '''
}

// Service periods; service state is independent of payment.
Table restaurant_subscription_periods {
  id uuid [pk]
  restaurant_id uuid [not null]
  starts_on date [not null]
  ends_on date [not null, note: 'Exclusive: this date is the next renewal date']
  years int [not null]
  amount_cents bigint [not null, note: 'Agreed total for this whole period']
  paid_on date [note: 'NULL means unpaid; one full payment per period']
  created_at timestamptz [not null]

  Indexes {
    (restaurant_id, starts_on)
  }
  Checks {
    `ends_on > starts_on` [name: 'ck_subscription_period_dates']
    `years BETWEEN 1 AND 9998` [name: 'ck_subscription_period_years']
    `amount_cents BETWEEN 1 AND 9007199254740991` [name: 'ck_subscription_period_amount']
  }
  Note: 'Non-overlap is enforced while holding the restaurant UPDATE lock. Collection never shifts the agreed dates. Paid amount and date are frozen; only the expiry endpoint changes a paid period. Every write requires the restaurant subscription_version.'
}

// 02 - Restaurant tables and one menu hierarchy
Table restaurant_tables {
  id uuid [pk]
  restaurant_id uuid [not null]
  table_label varchar(50) [not null]
  qr_token varchar(128) [not null, unique, note: 'Random fixed QR entrance token, not a join code']
  is_enabled boolean [not null, default: true]

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_tables_id_tenant']
    restaurant_id
    (restaurant_id, table_label) [unique, name: 'uq_tables_label']
  }

  Note: '''
    Labels are unique per restaurant until physical deletion.
    CatalogDeletionService locks the table, rejects ACTIVE sessions,
    clears closed sessions' table_id links, and deletes the table atomically.
    Historical table-label snapshots and restaurant ownership are retained.
    To replace a QR token, delete the inactive table, create a new table,
    and reprint its QR code. Permanent restaurant deletion removes all its data.
  '''
}

Table menu_categories {
  id uuid [pk]
  restaurant_id uuid [not null]
  name_zh varchar(100)
  name_it varchar(100)
  name_en varchar(100)

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_categories_id_tenant']
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_category_has_name']
  }

  Note: 'At least one localized name; normalize whitespace-only names to NULL. Client falls back to another available translation. Delete only after all items are removed or moved.'
}

Table menu_items {
  id uuid [pk]
  restaurant_id uuid [not null]
  category_id uuid [not null]
  item_code varchar(40)
  name_zh varchar(150)
  name_it varchar(150)
  name_en varchar(150)
  description_zh text
  description_it text
  description_en text
  price_cents bigint [not null]
  allergen_codes "text[]" [not null, default: '{}', note: 'Only 14 predefined EU allergen codes, validated by the API']
  allergen_reviewed boolean [not null, default: false, note: 'true + empty codes = reviewed, no identified declarable allergens']
  is_available boolean [not null, default: true]
  image_id uuid [note: 'Current menu_item_images.id; no FK, written only together with that table']

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_menu_items_id_tenant']
    (restaurant_id, category_id)
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_item_has_name']
    `price_cents > 0` [name: 'ck_item_positive_price']
  }

  Note: '''
    No menus or allergens tables in MVP.
    Require at least one localized name when saving.
    Normalize blank names/codes to NULL.
    EF Core filtered unique index uq_menu_items_code: (restaurant_id, item_code)
      WHERE item_code IS NOT NULL.
    CatalogDeletionService clears order_items.menu_item_id before deleting
    the item, retaining snapshots and restaurant ownership in one transaction.
    allergen_reviewed=false means no completed restaurant review.
    allergen_reviewed=true + empty allergen_codes means reviewed and
    no identified declarable allergens; do not promise zero cross-contact.
    Reconfirm allergen review on every item content save, even if sold out.
    Photo and availability writes do not require another content review.
  '''
}

Table menu_item_images {
  id uuid [pk, note: 'Random per upload; also the immutable public image URL id']
  menu_item_id uuid [not null, unique]
  content bytea [not null, note: '640x640 WebP re-encoded by the API; no EXIF']

  Note: '''
    Optional dish photo, at most one per item. Kept apart from menu_items so
    menu reads never load image bytes. Not part of order snapshots.
  '''
}

Table menu_option_groups {
  id uuid [pk]
  restaurant_id uuid [not null]
  name_zh varchar(100)
  name_it varchar(100)
  name_en varchar(100)
  min_select int [not null, note: '0 = optional; at least 1 = required']
  max_select int [not null]
  position int [not null, note: 'One restaurant-wide display order shared by every dish']

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_option_groups_id_tenant']
    (restaurant_id, position)
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_option_group_has_name']
    `min_select >= 0 AND max_select >= 1 AND min_select <= max_select` [name: 'ck_option_group_selection']
  }

  Note: '''
    Shared, generic choices such as size, sweetness, ice, toppings or spice level.
    The API also keeps max_select within the number of options (1-30 per group),
    at most 50 groups per restaurant and 10 per dish.
  '''
}

Table menu_options {
  id uuid [pk]
  restaurant_id uuid [not null]
  group_id uuid [not null]
  name_zh varchar(100)
  name_it varchar(100)
  name_en varchar(100)
  price_delta_cents bigint [not null, note: 'Added to the dish price per portion']
  allergen_codes "text[]" [not null, default: '{}', note: 'Orders add them to the dish allergens']
  is_available boolean [not null, default: true, note: 'Sold-out switch, also for STAFF']
  position int [not null, note: 'Order within the group']

  Indexes {
    restaurant_id
    (group_id, restaurant_id)
  }

  Checks {
    `concat(name_zh, name_it, name_en) ~ '[^[:space:]]'` [name: 'ck_option_has_name']
    `price_delta_cents >= 0` [name: 'ck_option_price_delta']
  }
}

Table menu_item_option_groups {
  menu_item_id uuid [not null]
  group_id uuid [not null]
  restaurant_id uuid [not null]

  Indexes {
    (menu_item_id, group_id) [pk]
    restaurant_id
    (group_id, restaurant_id)
    (menu_item_id, restaurant_id)
  }

  Note: 'Pure join table; display order comes from menu_option_groups.position.'
}

// 03 - Each visit, submission, and immutable order lines
Table dining_sessions {
  id uuid [pk]
  restaurant_id uuid [not null]
  channel varchar(10) [not null, default: 'DINE_IN', note: 'DINE_IN, PICKUP or DELIVERY; fixed at creation']
  table_id uuid [note: 'Dine-in only; nullable for retained closed history after table deletion']
  status varchar(10) [not null, default: 'ACTIVE']
  join_code_ciphertext text [note: 'Encrypt reversible 4-character join code; NULL after closing']
  bill_version int [not null, default: 1, note: 'Per-session counter. Increment once per successful new order or cancellation']
  table_label_snapshot varchar(50) [note: 'Dine-in only']
  delivery_fee_cents bigint [note: 'Delivery only, and then required']
  opened_at timestamptz [not null, default: `now()`, note: 'Online sessions: the acceptance time']
  closed_at timestamptz
  close_reason varchar(10)
  closed_total_cents bigint

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_sessions_id_tenant']
    (table_id, status)
    restaurant_id
    (restaurant_id, opened_at) [name: 'ix_dining_sessions_active', note: 'Partial: WHERE status = ACTIVE (bills page, online orders in progress)']
  }

  Checks {
    `status IN ('ACTIVE', 'CLOSED')` [name: 'ck_session_status']
    `bill_version > 0` [name: 'ck_session_bill_version']
    `channel IN ('DINE_IN', 'PICKUP', 'DELIVERY')` [name: 'ck_session_channel']
    `channel <> 'DINE_IN' OR (table_label_snapshot IS NOT NULL AND (status <> 'ACTIVE' OR (table_id IS NOT NULL AND join_code_ciphertext IS NOT NULL)))` [name: 'ck_session_dine_in']
    `channel = 'DINE_IN' OR (table_id IS NULL AND table_label_snapshot IS NULL AND join_code_ciphertext IS NULL)` [name: 'ck_session_online']
    `close_reason IS NULL OR close_reason IN ('PAID', 'VOIDED') OR (close_reason = 'EMPTY' AND channel = 'DINE_IN') OR (close_reason = 'NO_SHOW' AND channel <> 'DINE_IN')` [name: 'ck_session_close_reason']
    `(channel = 'DELIVERY' AND delivery_fee_cents IS NOT NULL AND delivery_fee_cents >= 0) OR (channel <> 'DELIVERY' AND delivery_fee_cents IS NULL)` [name: 'ck_session_delivery_fee']
    `(status = 'ACTIVE' AND closed_at IS NULL AND close_reason IS NULL AND closed_total_cents IS NULL) OR (status = 'CLOSED' AND closed_at IS NOT NULL AND close_reason IS NOT NULL AND closed_total_cents IS NOT NULL AND join_code_ciphertext IS NULL)` [name: 'ck_session_lifecycle']
    `closed_total_cents IS NULL OR closed_total_cents >= 0` [name: 'ck_session_closed_total']
    `closed_at IS NULL OR closed_at >= opened_at` [name: 'ck_session_close_time']
  }

  Note: '''
    A session is a dine-in visit at a table, or an accepted online order
    (PICKUP or DELIVERY) with no table, label or join code.
    EF Core filtered unique index: (table_id) WHERE status = 'ACTIVE'.
    Opening/closing timestamps are retained without shared-account attribution.
    No join-code or QR reset in V1. A protected HttpOnly guest cookie
    binds restaurant, table, and session; it never stores the join code.
    Validate cookie and ACTIVE session on every protected guest request.
    After network failure, open-table UI must query current table state
    and require fresh staff confirmation, not auto-retry the old POST.
    bill_version begins at 1 for each new session and increments only
    when a new order is persisted or an individual order line is cancelled.
    Order creation, line cancellation and checkout must lock this session row
    inside their transactions. Checkout compares expected bill_version
    and confirmed amount before closing.
  '''
}

Table orders {
  id uuid [pk]
  restaurant_id uuid [not null]
  dining_session_id uuid [not null]
  client_request_id uuid [not null, note: 'Same ID on retry; not a secret']
  status varchar(12) [not null, default: 'NEW']
  total_amount_cents bigint [not null]
  default_language_snapshot varchar(2) [not null]
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  Indexes {
    (id, restaurant_id) [unique, name: 'uq_orders_id_tenant']
    (dining_session_id, client_request_id) [unique, name: 'uq_order_one_per_request']
    (restaurant_id, status, created_at, id)
    (restaurant_id, status, processed_at, id)
  }

  Checks {
    `status IN ('NEW', 'PROCESSED')` [name: 'ck_order_status']
    `total_amount_cents >= 0` [name: 'ck_order_amount']
    `default_language_snapshot IN ('zh', 'it', 'en')` [name: 'ck_order_language']
    `(status = 'NEW' AND processed_at IS NULL) OR (status = 'PROCESSED' AND processed_at IS NOT NULL)` [name: 'ck_order_lifecycle']
    `processed_at IS NULL OR processed_at >= created_at` [name: 'ck_order_transition_times']
  }

  Note: '''
    Each submission or add-on creates one order.
    Retry with the same client_request_id returns the original order,
    even if the resent payload differs; it never creates a second one.
    The UI preserves the original payload
    while status is unknown and shows the persisted server result.
    Enforce idempotency and amounts with PostgreSQL constraints + transactions.
    NEW while any item is NEW; otherwise PROCESSED with latest item transition time.
    Original total stays immutable; payable amount sums uncancelled item snapshots.
    No order version field is needed.
    Do not allow guest access to orders after the session closes.
  '''
}


Table order_items {
  id uuid [pk]
  restaurant_id uuid [not null]
  order_id uuid [not null]
  menu_item_id uuid [note: 'Nullable after menu item deletion; snapshots remain']
  item_code_snapshot varchar(40)
  name_zh_snapshot varchar(150)
  name_it_snapshot varchar(150)
  name_en_snapshot varchar(150)
  allergen_codes_snapshot "text[]" [not null, default: '{}']
  unit_price_cents bigint [not null]
  quantity int [not null]
  remark text
  options_snapshot jsonb [not null, default: '[]', note: 'Chosen options: group and option names, price delta; display order']
  status varchar(12) [not null, default: 'NEW']
  ready_at timestamptz
  cancelled_at timestamptz
  served_at timestamptz [note: 'Taken from the pass by a waiter, or set to closed_at by closure; never affects the bill']

  Indexes {
    (order_id, restaurant_id)
    restaurant_id
    (restaurant_id, ready_at, id) [note: "Partial: WHERE status = 'READY' AND served_at IS NULL (pass queue)"]
  }

  Checks {
    `concat(name_zh_snapshot, name_it_snapshot, name_en_snapshot) ~ '[^[:space:]]'` [name: 'ck_order_item_has_name']
    `unit_price_cents >= 0` [name: 'ck_order_item_unit_price']
    `quantity > 0` [name: 'ck_order_item_quantity']
    `status IN ('NEW', 'READY', 'CANCELLED')` [name: 'ck_order_item_status']
    `(status = 'NEW' AND ready_at IS NULL AND cancelled_at IS NULL) OR (status = 'READY' AND ready_at IS NOT NULL AND cancelled_at IS NULL) OR (status = 'CANCELLED' AND cancelled_at IS NOT NULL AND (ready_at IS NULL OR cancelled_at >= ready_at))` [name: 'ck_order_item_lifecycle']
    `served_at IS NULL OR (status = 'READY' AND served_at >= ready_at)` [name: 'ck_order_item_served']
    `jsonb_typeof(options_snapshot) = 'array'` [name: 'ck_order_item_options']
  }

  Note: 'Historical name, price, allergen and option snapshots. unit_price_cents includes option deltas; line total = unit_price_cents * quantity; no separate line_total_cents.'
}

// Restaurant ownership: a permanent restaurant DELETE removes the entire tenant.
Ref: restaurant_users.restaurant_id > restaurants.id [delete: cascade]
Ref: restaurant_subscription_periods.restaurant_id > restaurants.id [delete: cascade]
Ref: online_hours.restaurant_id > restaurants.id [delete: cascade]
Ref: online_counters.restaurant_id > restaurants.id [delete: cascade]
Ref: online_requests.restaurant_id > restaurants.id [delete: cascade]
Ref: push_subscriptions.restaurant_id > restaurants.id [delete: cascade]
Ref: restaurant_tables.restaurant_id > restaurants.id [delete: cascade]
Ref: menu_categories.restaurant_id > restaurants.id [delete: cascade]
Ref: menu_items.restaurant_id > restaurants.id [delete: cascade]
Ref: menu_option_groups.restaurant_id > restaurants.id [delete: cascade]
Ref: dining_sessions.restaurant_id > restaurants.id [delete: cascade]
Ref: orders.restaurant_id > restaurants.id [delete: cascade]
Ref: order_items.restaurant_id > restaurants.id [delete: cascade]

// Nullable historical links are explicitly detached by catalog deletion operations.
// Composite FKs keep related records in the same restaurant.
Ref: menu_items.(category_id, restaurant_id) > menu_categories.(id, restaurant_id) [delete: no action]
Ref: menu_item_images.menu_item_id - menu_items.id [delete: cascade]
Ref: menu_options.(group_id, restaurant_id) > menu_option_groups.(id, restaurant_id) [delete: cascade]
Ref: menu_item_option_groups.(menu_item_id, restaurant_id) > menu_items.(id, restaurant_id) [delete: cascade]
Ref: menu_item_option_groups.(group_id, restaurant_id) > menu_option_groups.(id, restaurant_id) [delete: cascade]
Ref: dining_sessions.(table_id, restaurant_id) > restaurant_tables.(id, restaurant_id) [delete: no action]
Ref: orders.(dining_session_id, restaurant_id) > dining_sessions.(id, restaurant_id) [delete: cascade]
Ref: online_requests.(session_id, restaurant_id) - dining_sessions.(id, restaurant_id) [delete: no action]
Ref: push_subscriptions.(user_id, restaurant_id) > restaurant_users.(id, restaurant_id) [delete: cascade]
Ref: order_items.(order_id, restaurant_id) > orders.(id, restaurant_id) [delete: cascade]
Ref: order_items.(menu_item_id, restaurant_id) > menu_items.(id, restaurant_id) [delete: no action]

TableGroup platform_and_accounts {
  platform_users
  restaurants
  restaurant_users
  restaurant_subscription_periods
  online_hours
}

TableGroup tables_and_menu {
  restaurant_tables
  menu_categories
  menu_items
  menu_item_images
  menu_option_groups
  menu_options
  menu_item_option_groups
}

TableGroup dining_and_orders {
  dining_sessions
  orders
  order_items
}

TableGroup online_ordering {
  online_counters
  online_requests
  push_subscriptions
}
