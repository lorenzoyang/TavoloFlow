# Copy to /opt/tavoloflow/.env on the VPS, then chmod 600 .env.
# Hostname only, without https:// or a path. It must equal the host of the PUBLIC_ORIGIN
# the release was built with (build-release.sh); the installer refuses a mismatch.
DOMAIN=app.example.com
# A real email address for certificate account notifications.
ACME_EMAIL=replace-me@example.com
POSTGRES_DB=tavoloflow
POSTGRES_USER=tavoloflow
# Generate with: openssl rand -hex 32 (hex avoids Compose/connection-string escaping).
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# Lock-screen push key, generated once with: openssl rand -hex 32 (a different value from the password).
# Keep it: a new key makes every staff device turn notifications on again.
VAPID_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Managed Turnstile widget for DOMAIN; no DNS/proxy migration is required.
# Enabled by default in production. These are keys from Cloudflare, NOT generated with openssl.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
# Optional Geoapify API key for automatic delivery quotes; leave empty to keep them off. Restrict the
# key in Geoapify to this server's public IP: it is only used by the API, never by browsers.
GEOAPIFY_API_KEY=
# If the subnet overlaps another Docker network, change all THREE values before first launch.
PROXY_SUBNET=172.30.80.0/24
PROXY_DYNAMIC_RANGE=172.30.80.128/25
CADDY_IP=172.30.80.2
