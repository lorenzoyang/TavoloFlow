# Copy to /opt/tavoloflow/.env on the VPS, then chmod 600 .env.
# Business hostname only; the marketing website is hosted separately.
DOMAIN=app.qiaotavoloflow.it
# A real email address for certificate account notifications.
ACME_EMAIL=replace-me@example.com
POSTGRES_DB=tavoloflow
POSTGRES_USER=tavoloflow
# Generate with: openssl rand -hex 32 (hex avoids Compose/connection-string escaping).
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# If the subnet overlaps another Docker network, change all THREE values before first launch.
PROXY_SUBNET=172.30.80.0/24
PROXY_DYNAMIC_RANGE=172.30.80.128/25
CADDY_IP=172.30.80.2
