{$SITE_ADDRESS} {
    import /etc/caddy/tls.conf
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /api {
        reverse_proxy api:8080
    }
    handle {
        root * /srv
        route {
            try_files {path} /index.html
            @entry path /index.html
            header @entry Cache-Control "no-cache"
            file_server
        }
    }
}
